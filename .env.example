APP_NAME=CronoFutbol
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

LOG_CHANNEL=stack
LOG_LEVEL=debug

# Base de datos (AMPPS: usuario root, clave "mysql"; crea la base "cronofutbol" en phpMyAdmin)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=cronofutbol
DB_USERNAME=root
DB_PASSWORD=mysql

SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync
ROL_REGISTRO=Aficionado

# --- Si usas Docker (docker compose up -d) cambia estas lineas por: ---
# DB_HOST=db
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=1234
